generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Courier {
  id                  String   @id
  name                String
  status              String   @default("UNAVAILABLE")
  tier                String   @default("STANDARD")
  walletBalance       Float    @default(0)
  activeDeliveryIds   String[] @default([])
  currentRestaurantId String?

  deliveries Delivery[]
}

model Delivery {
  id               String  @id
  orderId          String
  restaurantId     String
  pickupLatitude   Float
  pickupLongitude  Float
  dropoffLatitude  Float
  dropoffLongitude Float
  distanceKm       Float
  tipEur           Float
  status           String  @default("PENDING")
  courierId        String?

  courier Courier? @relation(fields: [courierId], references: [id])

  @@index([status])
  @@index([courierId])
}

model Message {
  id         String   @id
  senderId   String
  content    String
  type       String
  sentAt     DateTime @default(now())
  receiverId String?
  roomId     String?

  @@index([type, roomId, sentAt])
  @@index([type, senderId, receiverId, sentAt])
}

model Restaurant {
  id        String  @id
  ownerId   String
  name      String
  latitude  Float
  longitude Float
  isOpen    Boolean @default(true)
  consumables Consumable[]
  menus        Menu[]
  orders       Order[]

  @@index([ownerId])
}

model User {
  id        String   @id
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())

  orders Order[]
  carts  Cart[]
}

model Consumable {
  id           String  @id
  name         String
  description  String?
  price        Float
  stock        Int
  restaurantId String

  restaurant Restaurant? @relation(fields: [restaurantId], references: [id])
}

model Menu {
  id           String @id
  restaurantId String
  title        String

  restaurant Restaurant? @relation(fields: [restaurantId], references: [id])
}

model Order {
  id                String   @id
  clientId          String
  restaurantId      String
  status            String   @default("PENDING")
  tipEur            Float    @default(0)
  totalEur          Float?
  items             String[] @default([])
  clientLatitude    Float?
  clientLongitude   Float?
  createdAt         DateTime @default(now())

  client   User? @relation(fields: [clientId], references: [id])
  restaurant Restaurant? @relation(fields: [restaurantId], references: [id])
}

model Cart {
  id        String  @id
  userId    String
  items     String[] @default([])
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id])
}
